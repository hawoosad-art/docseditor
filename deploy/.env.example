# DocsEditor production environment — copy to <app>/.env and fill in.
# .env is git-ignored; chmod 600 it on the server. Node loads it via
# `--env-file=.env` (configured in deploy/ecosystem.config.js).

# ── core ────────────────────────────────────────────────────────────────────
PORT=3000
# Required when the app sits behind nginx so rate limiters see real client IPs.
TRUST_PROXY=1

# ── admin panel + card designer ─────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=CHANGE-ME-strong-password

# ── session / attestation (FaceGate) ────────────────────────────────────────
# SESSION_SECRET is auto-generated by deploy/setup.sh; set manually if not.
SESSION_SECRET=
# Only needed if the Android app embeds the attestation flow.
ATTEST_SECRET=
EXPECTED_APP_CERT=

# ── AI features (demo-card copy + card designer AI) ─────────────────────────
# One key powers both. Card designer AI = "AI: read template" (auto-position
# the fields on your template) and typo-proofreading before print.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TEXT_MODEL=gpt-5-mini
# DEMO_CARD_DISABLE_AI=1
# CARD_AI_CORRECT=0   # stop AI from auto-fixing field typos
# CARD_AI_DISABLE=1   # turn off all card-designer AI tools

# ── APK uploads ─────────────────────────────────────────────────────────────
UPLOAD_TOKEN=

# ── Telegram bot trial keys / swishy notifications (optional) ───────────────
BOT_TRIAL_SECRET=
SWISHY_NOTIFY_BOT_TOKEN=
SWISHY_NOTIFY_CHAT_ID=
